            ]
          },
          {
            "name": "Walking Lunges",
            "sets": 3,
            "reps": "10-12 per leg",
            "muscles": ["Quads", "Glutes", "Hamstrings"],
            "notes": [
              "Take controlled steps.",
              "Keep torso upright."
            ]
          },
          {
            "name": "Leg Extension",
            "sets": 2,
            "reps": "12-15",
            "muscles": ["Quads"],
            "notes": [
              "Skip if doing Romanian Deadlift.",
              "Avoid swinging.",
              "Pause at top."
            ]
          },
          {
            "name": "Calf Raises",
            "sets": 3,
            "reps": "12-20",
            "muscles": ["Calves"],
            "notes": [
              "Use full stretch.",
              "Pause at top."
            ]
          },
          {
            "name": "Crunches or Leg Raises",
            "sets": 3,
            "reps": "10-20",
            "muscles": ["Abs", "Hip flexors"],
            "refVideo": "https://www.youtube.com/shorts/fbGDQGHxvHk",
