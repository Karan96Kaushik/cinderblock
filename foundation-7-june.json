    "globalNotes": [
      "Warm up for 5-10 minutes before lifting.",
      "Use a weight that leaves 1-3 reps in reserve (RIR) at the end of each set.",
      "Rest 2-3 minutes between compound exercises.",
      "Rest 60-90 seconds between isolation exercises.",
      "Focus on controlled movement rather than moving weight quickly.",
      "Track weights and reps every session.",
      "When all sets reach the top of the rep range, increase weight by the smallest available increment.",
      "Protein target: 1.6-2.2g per kg bodyweight daily.",
      "Sleep 7-9 hours per night.",
      "Consistency matters more than exercise variety."
    ],
    "progression": {
      "method": "Double Progression",
      "example": {
        "exercise": "Leg Press",
        "week1": ["100kg x 10", "100kg x 10", "100kg x 9", "100kg x 8"],
        "week2": ["100kg x 12", "100kg x 11", "100kg x 10", "100kg x 10"],
        "week3": ["100kg x 12", "100kg x 12", "100kg x 12", "100kg x 12"],
        "nextStep": "Increase to 105kg"
      }
    },
    "weeks": {
      "week 1-2": [
        "Learn technique.",
        "Leave 2-3 reps in reserve.",
        "Do not train to failure."
      ],
      "week 3-6": [
        "Begin pushing closer to the top of rep ranges.",
        "Increase weights where appropriate."
      ],
      "week 7-8": [
        "Review progress.",
        "Compare strength numbers to Week 1.",
        "Consider a lighter week if feeling fatigued."
      ]
