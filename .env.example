# Frontend — optional cloud backends (either or both)

# Existing API Gateway sync for gym logs + body metrics (optional)
VITE_API_URL=https://your-api-id.execute-api.eu-west-1.amazonaws.com/prod

# Supabase — settings, active run plan, backups, optional auth
# Create a project at https://supabase.com, then:
# 1. Run supabase/schema.sql in the SQL editor
# 2. Settings → API Keys → Publishable and secret API keys
#
# Browser / PWA: use the publishable key only (sb_publishable_...)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server / Edge Functions only — never expose via VITE_* (bypasses RLS)
# SUPABASE_SECRET_KEY=sb_secret_...
