# Frontend — optional cloud backends (either or both)

# Existing API Gateway sync for gym logs + body metrics (optional)
VITE_API_URL=https://your-api-id.execute-api.eu-west-1.amazonaws.com/prod

# Supabase — settings, active run plan, backups, optional auth
# Create a project at https://supabase.com, then:
# 1. Run supabase/schema.sql in the SQL editor
# 2. Settings → API Keys → Publishable and secret API keys
#
# IMPORTANT: use the Project URL only — do NOT include /rest/v1
# ✅ https://xxxx.supabase.co
# ❌ https://xxxx.supabase.co/rest/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret (service role) — Amplify Lambda only. Never import this in Vite client code.
# Set as an Amplify secret for the sandbox/deploy:
#   npx ampx sandbox secret set VITE_SUPABASE_SECRET_KEY
# Also export VITE_SUPABASE_URL in the shell (or .env) before `npx ampx sandbox` so the
# function receives the project URL at synthesize time.
VITE_SUPABASE_SECRET_KEY=sb_secret_...
